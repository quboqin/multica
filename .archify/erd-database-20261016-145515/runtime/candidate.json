  "cards": [
    {
      "dot": "cyan",
      "title": "范围与来源",
      "items": [
        "本域 4 张表、44 个字段；另展开 3 张外键目标表作为上下文，全部保留完整字段。",
        "引用域的表可在各自分图单独查看。连线展开本域的外键，引用域自身的外键保留在字段 references 和总览字典中。来自 615 份迁移在隔离 PostgreSQL 17 中重放后的最终 schema。"
      ]
    },
    {
      "dot": "amber",
      "title": "如何阅读键与连线",
      "items": [
        "PK 为真实主键；FK 为实际数据库外键；UK 为无条件唯一键或复合唯一键的组成字段，不表示复合键的每个字段单独唯一。",
        "实线表示实际 FK；虚线仅表示 SQL 中已核实的应用关联，数据库不保证引用完整性。关系端点表示业务上限；逻辑引用仍可能出现悬空值。",
        "部分唯一索引不标为无条件 UK，其完整谓词保留在数据字典中。自引用保留在字段信息中，不绘制回环。"
      ]
    },
    {
      "dot": "violet",
      "title": "跨域数据库外键",
      "items": [
        "agent_runtime.workspace_id → workspace.id",
        "agent_runtime.owner_id → user.id",
        "daemon_connection.agent_id → agent.id",
        "daemon_token.workspace_id → workspace.id"
      ]
    },
    {
      "dot": "emerald",
      "title": "复合键与条件唯一性",
      "items": [
        "CREATE UNIQUE INDEX agent_runtime_workspace_daemon_profile_key ON public.agent_runtime USING btree (workspace_id, daemon_id, profile_id) WHERE (profile_id IS NOT NULL)",
        "CREATE UNIQUE INDEX agent_runtime_workspace_daemon_provider_key ON public.agent_runtime USING btree (workspace_id, daemon_id, provider) WHERE (profile_id IS NULL)",
        "CREATE UNIQUE INDEX runtime_profile_workspace_id_display_name_key ON public.runtime_profile USING btree (workspace_id, display_name)",
        "CREATE UNIQUE INDEX uq_daemon_agent ON public.daemon_connection USING btree (agent_id, daemon_id)"
      ]
    }
  ]
