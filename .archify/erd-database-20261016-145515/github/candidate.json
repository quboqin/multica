  "cards": [
    {
      "dot": "cyan",
      "title": "范围与来源",
      "items": [
        "本域 6 张表、61 个字段；另展开 4 张外键目标表作为上下文，全部保留完整字段。",
        "引用域的表可在各自分图单独查看。连线展开本域的外键，引用域自身的外键保留在字段 references 和总览字典中。来自 615 份迁移在隔离 PostgreSQL 17 中重放后的最终 schema。"
      ]
    },
    {
      "dot": "amber",
      "title": "如何阅读键与连线",
      "items": [
        "PK 为真实主键；FK 为实际数据库外键；UK 为无条件唯一键或复合唯一键的组成字段，不表示复合键的每个字段单独唯一。",
        "实线表示实际 FK；虚线仅表示 SQL 中已核实的应用关联，数据库不保证引用完整性。关系端点表示业务上限；逻辑引用仍可能出现悬空值。",
        "部分唯一索引不标为无条件 UK，其完整谓词保留在数据字典中。自引用保留在字段信息中，不绘制回环。"
      ]
    },
    {
      "dot": "violet",
      "title": "跨域数据库外键",
      "items": [
        "github_installation.workspace_id → workspace.id",
        "github_installation.connected_by_id → user.id",
        "github_pull_request.workspace_id → workspace.id",
        "issue_pull_request.issue_id → issue.id"
      ]
    },
    {
      "dot": "emerald",
      "title": "复合键与条件唯一性",
      "items": [
        "CREATE UNIQUE INDEX github_installation_workspace_id_installation_id_key ON public.github_installation USING btree (workspace_id, installation_id)",
        "CREATE UNIQUE INDEX github_pull_request_workspace_id_repo_owner_repo_name_pr_nu_key ON public.github_pull_request USING btree (workspace_id, repo_owner, repo_name, pr_number)",
        "CREATE UNIQUE INDEX issue_pull_request_pkey ON public.issue_pull_request USING btree (issue_id, pull_request_id)",
        "CREATE UNIQUE INDEX issue_pull_request_exclusion_pkey ON public.issue_pull_request_exclusion USING btree (issue_id, pull_request_id)"
      ]
    }
  ]
