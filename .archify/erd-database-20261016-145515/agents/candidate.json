  "cards": [
    {
      "dot": "cyan",
      "title": "范围与来源",
      "items": [
        "本域 6 张表、53 个字段；另展开 3 张外键目标表作为上下文，全部保留完整字段。",
        "引用域的表可在各自分图单独查看。连线展开本域的外键，引用域自身的外键保留在字段 references 和总览字典中。来自 615 份迁移在隔离 PostgreSQL 17 中重放后的最终 schema。"
      ]
    },
    {
      "dot": "amber",
      "title": "如何阅读键与连线",
      "items": [
        "PK 为真实主键；FK 为实际数据库外键；UK 为无条件唯一键或复合唯一键的组成字段，不表示复合键的每个字段单独唯一。",
        "实线表示实际 FK；虚线仅表示 SQL 中已核实的应用关联，数据库不保证引用完整性。关系端点表示业务上限；逻辑引用仍可能出现悬空值。",
        "部分唯一索引不标为无条件 UK，其完整谓词保留在数据字典中。自引用保留在字段信息中，不绘制回环。"
      ]
    },
    {
      "dot": "violet",
      "title": "跨域数据库外键",
      "items": [
        "agent.workspace_id → workspace.id",
        "agent.owner_id → user.id",
        "agent.runtime_id → agent_runtime.id",
        "agent.archived_by → user.id"
      ]
    },
    {
      "dot": "emerald",
      "title": "复合键与条件唯一性",
      "items": [
        "CREATE UNIQUE INDEX agent_workspace_name_unique ON public.agent USING btree (workspace_id, name)",
        "CREATE UNIQUE INDEX agent_system_identity_unique ON public.agent USING btree (workspace_id, owner_id, runtime_id, system_key) WHERE (system_key IS NOT NULL)",
        "CREATE UNIQUE INDEX agent_invocation_target_agent_id_target_type_target_id_key ON public.agent_invocation_target USING btree (agent_id, target_type, target_id)",
        "CREATE UNIQUE INDEX agent_to_label_pkey ON public.agent_to_label USING btree (agent_id, label_id)",
        "CREATE UNIQUE INDEX agent_mcp_server_pkey ON public.agent_mcp_server USING btree (agent_id, server_id)",
        "CREATE UNIQUE INDEX idx_workspace_mcp_server_workspace_name ON public.workspace_mcp_server USING btree (workspace_id, name)"
      ]
    }
  ]
