  "cards": [
    {
      "dot": "cyan",
      "title": "范围与来源",
      "items": [
        "本域 6 张表、41 个字段；另展开 4 张外键目标表作为上下文，全部保留完整字段。",
        "引用域的表可在各自分图单独查看。连线展开本域的外键，引用域自身的外键保留在字段 references 和总览字典中。来自 615 份迁移在隔离 PostgreSQL 17 中重放后的最终 schema。"
      ]
    },
    {
      "dot": "amber",
      "title": "如何阅读键与连线",
      "items": [
        "PK 为真实主键；FK 为实际数据库外键；UK 为无条件唯一键或复合唯一键的组成字段，不表示复合键的每个字段单独唯一。",
        "实线表示实际 FK；虚线仅表示 SQL 中已核实的应用关联，数据库不保证引用完整性。关系端点表示业务上限；逻辑引用仍可能出现悬空值。",
        "部分唯一索引不标为无条件 UK，其完整谓词保留在数据字典中。自引用保留在字段信息中，不绘制回环。"
      ]
    },
    {
      "dot": "violet",
      "title": "跨域数据库外键",
      "items": [
        "agent_skill.agent_id → agent.id",
        "skill.workspace_id → workspace.id",
        "skill.created_by → user.id",
        "squad.workspace_id → workspace.id",
        "squad.leader_id → agent.id"
      ]
    },
    {
      "dot": "emerald",
      "title": "复合键与条件唯一性",
      "items": [
        "CREATE UNIQUE INDEX skill_workspace_id_name_key ON public.skill USING btree (workspace_id, name)",
        "CREATE UNIQUE INDEX skill_file_skill_id_path_key ON public.skill_file USING btree (skill_id, path)",
        "CREATE UNIQUE INDEX agent_skill_pkey ON public.agent_skill USING btree (agent_id, skill_id)",
        "CREATE UNIQUE INDEX skill_to_label_pkey ON public.skill_to_label USING btree (skill_id, label_id)",
        "CREATE UNIQUE INDEX squad_member_squad_id_member_type_member_id_key ON public.squad_member USING btree (squad_id, member_type, member_id)"
      ]
    }
  ]
}
