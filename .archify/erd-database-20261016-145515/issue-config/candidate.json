    {
      "dot": "cyan",
      "title": "范围与来源",
      "items": [
        "本分图完整展示 5 张表、60 个物理字段。来自当前提交的 615 份迁移在隔离 PostgreSQL 17 中重放后的 schema。",
        "跨域外键保留在字段 references 中；其他业务域见总览。字典另含 NULL、默认值、注释、索引及约束定义。"
      ]
    },
    {
      "dot": "amber",
      "title": "如何阅读键与连线",
      "items": [
        "PK 为真实主键；FK 为实际数据库外键；UK 为无条件唯一键或复合唯一键的组成字段，不表示复合键的每个字段单独唯一。",
        "实线表示实际 FK；虚线仅表示 SQL 中已核实的应用关联，数据库不保证引用完整性。关系端点表示业务上限；逻辑引用仍可能出现悬空值。",
        "部分唯一索引不标为无条件 UK，其完整谓词保留在数据字典中。自引用保留在字段信息中，不绘制回环。"
      ]
    },
    {
      "dot": "emerald",
      "title": "复合键与条件唯一性",
      "items": [
        "CREATE UNIQUE INDEX idx_issue_status_workspace_key ON public.issue_status USING btree (workspace_id, key)",
        "CREATE UNIQUE INDEX idx_issue_status_workspace_name_active ON public.issue_status USING btree (workspace_id, lower(name)) WHERE (archived_at IS NULL)",
        "CREATE UNIQUE INDEX issue_view_preference_pkey ON public.issue_view_preference USING btree (workspace_id, user_id, scope_type, scope_id)"
      ]
    }
  ]
